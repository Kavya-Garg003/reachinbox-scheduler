NODE_ENV=development
PORT=4000
# Public URL of THIS backend (used for OAuth redirect URIs). Prod: your https URL.
APP_URL=http://localhost:4000
# Where the React app lives. Dev: Vite (5173). Prod (single deploy): same as APP_URL.
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

REDIS_URL=redis://localhost:6379
DATABASE_URL=mysql://root:root@localhost:3306/reachinbox
ELASTICSEARCH_URL=http://localhost:9200
# Only for hosted Elasticsearch (Elastic Cloud): use an API key OR username/password
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
# Set to true for managed MySQL that requires TLS (Aiven, TiDB Cloud, ...)
DATABASE_SSL=false

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client, type "Web")
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack OAuth (api.slack.com/apps -> scope: incoming-webhook)
# Redirect URL: {APP_URL}/api/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Worker / throughput
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Rate limit (per sender, per hour)
DEFAULT_EMAILS_PER_HOUR_PER_SENDER=50
MAX_EMAILS_PER_HOUR_PER_SENDER=200
SENDERS_PER_USER=3

# Set RUN_WORKER=false to run API only, RUN_API=false to run worker only
RUN_WORKER=true
RUN_API=true

# Basic-auth for /admin/queues (Bull Board)
BULL_BOARD_USER=admin
BULL_BOARD_PASS=admin
